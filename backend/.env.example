# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/sales_agent

# Google Gemini AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Discovery Sources
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
SEARXNG_URL=http://localhost:8088
GMAPS_SCRAPER_API_URL=http://localhost:8085

# Cal.diy Self-Hosted Scheduling Configuration
CAL_BASE_URL=http://localhost:3000
CAL_CLOSER_SLUG=hafiz
CAL_EVENT_SLUG=30min
CAL_WEBHOOK_SECRET=your_cal_webhook_secret_here

# Python Scraper Service URL
SCRAPER_SERVICE_URL=http://localhost:8000

# Phase 2: Email Outreach & Transport Configuration
SEND_MODE=sandbox            # sandbox | live (default sandbox)
SANDBOX_INBOX=admin@example.com # in sandbox mode ALL outbound mail goes here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
SENDER_NAME=Cybells AI Solutions
SENDER_EMAIL=outreach@cybells.ai
SENDER_POSTAL_ADDRESS=123 Innovation Way, Tech Park, Suite 400
APP_BASE_URL=http://localhost:5000
UNSUBSCRIBE_SECRET=cybells_dev_unsubscribe_secret_key_12345
DAILY_SEND_CAP=25
MIN_DELAY_SECONDS=60
MAX_DELAY_SECONDS=180
